{
  "name": "canessa",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "lint": "eslint .",
    "compile": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "build": "pnpm assets && react-router build && node scripts/finalize-static.mjs && node scripts/verify-static.mjs && node scripts/fingerprint.mjs",
    "preview": "firebase emulators:start --only hosting --project demo-canessa",
    "verify:static": "node scripts/verify-static.mjs",
    "test:hosting": "firebase emulators:exec --only hosting --project demo-canessa \"playwright test\"",
    "assets": "node scripts/build-media.mjs",
    "predev": "pnpm assets"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.6",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "7.18.6",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gray-matter": "4.0.3",
    "happy-dom": "21.0.4",
    "marked": "16.4.2",
    "parse5": "8.1.1",
    "prettier": "3.10.1",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "firebase-tools": "15.37.0"
  }
}
